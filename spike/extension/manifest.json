{
  "manifest_version": 3,
  "name": "Magpie spike",
  "version": "0.0.1",
  "description": "Throwaway spike: does a new-tab extension keep the address bar focused, and does cached data show instantly?",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" },
  "optional_host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": { "id": "spike@magpie.hedgerow.tools", "strict_min_version": "128.0" }
  }
}
